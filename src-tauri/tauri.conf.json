{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARES-VII Hermes Bio-Astro Control",
  "version": "1.0.0",
  "identifier": "gov.nasa.ares7.hermes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "title": "ARES-VII • Hermes Autonomous Bio-Medical & Spacecraft Flight Control (Rust Engine)",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "appimage", "deb"],
    "icon": [
      "../public/icon-192x192.png",
      "../public/icon-512x512.png"
    ]
  }
}
