{
  "project": "Sonnenblume Autonomous Space Health OS",
  "cloudflare_architecture": {
    "ssl_tls_mode": "Full (Strict)",
    "edge_certificates": {
      "always_use_https": true,
      "minimum_tls_version": "1.3",
      "opportunistic_encryption": true,
      "tls_1_3": "on",
      "automatic_https_rewrites": true
    },
    "dns_records": [
      {
        "type": "CNAME",
        "name": "marketing",
        "target": "cname.vercel-dns.com",
        "proxy_status": "proxied (Orange Cloud)",
        "ttl": "Auto"
      },
      {
        "type": "CNAME",
        "name": "tool",
        "target": "cname.vercel-dns.com",
        "proxy_status": "proxied (Orange Cloud)",
        "ttl": "Auto"
      },
      {
        "type": "A",
        "name": "api-ec2",
        "target": "<YOUR_AWS_EC2_PUBLIC_IP>",
        "proxy_status": "proxied (Orange Cloud)",
        "ttl": "Auto",
        "description": "Proxies AWS EC2 Hermes & GMAT backend through Cloudflare DDoS shielding"
      }
    ],
    "waf_and_security": {
      "security_level": "Medium",
      "bot_fight_mode": true,
      "challenge_passage": "30 minutes",
      "browser_integrity_check": true,
      "rate_limiting_rules": [
        {
          "expression": "(http.request.uri.path matches \"^/api/ship/\")",
          "action": "Managed Challenge",
          "threshold": "10 requests per 10 seconds"
        }
      ]
    },
    "caching_rules": {
      "browser_cache_ttl": "4 hours",
      "edge_cache_ttl": "2 hours",
      "bypass_cache_on_cookie": true,
      "bypass_cache_paths": [
        "/api/*",
        "/ws/*"
      ]
    },
    "speed_optimizations": {
      "early_hints": true,
      "brotli": true,
      "http2": true,
      "http3_quic": true,
      "zero_rtt": true
    }
  }
}
